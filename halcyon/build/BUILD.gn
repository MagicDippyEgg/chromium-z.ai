import("halcyon_features.gni")
import("//build/buildflag_header.gni")

# The buildflag header target. C++ files include "halcyon/build/halcyon_buildflags.h"
# and use BUILDFLAG(ENABLE_HALCYON) to gate Halcyon-specific code.
# The header is generated at $target_gen_dir/halcyon_buildflags.h by the
# buildflag_header() template from //build/buildflag_header.gni.
buildflag_header("halcyon_buildflags") {
  header = "halcyon_buildflags.h"
  flags = [ "ENABLE_HALCYON=$enable_halcyon" ]
}

# Convenience source_set that other targets can depend on to get the
# buildflag header in their include path.
source_set("halcyon_buildflags_lib") {
  public_deps = [ ":halcyon_buildflags" ]
}
