import("halcyon_features.gni")

# The buildflag header target. C++ files include "halcyon/build/halcyon_buildflags.h"
# and use BUILDFLAG(ENABLE_HALCYON) to gate Halcyon-specific code. The header
# is generated by the buildflag_header() template defined in
# halcyon_features.gni.
source_set("halcyon_buildflags") {
  public_deps = [ ":halcyon_buildflags" ]
}
