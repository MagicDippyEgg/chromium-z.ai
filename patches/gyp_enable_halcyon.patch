+# Halcyon browser integration.
+# ============================
+# Conditionally pulls in every Halcyon Views and WebUI target when
+# enable_halcyon is true. Other source_sets in this file depend on
+# ":halcyon"; when enable_halcyon is false the deps list is empty so
+# the dependency is a no-op.
+source_set("halcyon") {
+  if (enable_halcyon) {
+    deps = [
+      "//halcyon:halcyon",
+      "//chrome/browser/themes:halcyon_theme",
+      "//chrome/browser/ui/views/frame:halcyon_browser_view",
+      "//chrome/browser/ui/views/toolbar:halcyon_toolbar_view",
+      "//chrome/browser/ui/views/tabs:halcyon_tab_strip",
+      "//chrome/browser/ui/views/tidemarks:halcyon_tidemarks_view",
+      "//chrome/browser/ui/views/privacy_lantern:halcyon_lantern_indicator",
+      "//chrome/browser/ui/views/bookmarks:halcyon_cairn_indicator",
+      "//chrome/browser/ui/views/location_bar:halcyon_omnibox_view",
+      "//chrome/browser/ui/webui:halcyon_ntp_ui",
+      "//chrome/browser/ui/webui:halcyon_about_ui",
+      "//chrome/browser/ui/webui:halcyon_quill_ui",
+      "//chrome/browser/ui/webui:halcyon_lantern_report_ui",
+      "//chrome/browser/ui/webui:halcyon_margin_notes_ui",
+      "//chrome/browser/resources/halcyon_ntp:halcyon_ntp_resources",
+      "//chrome/browser/resources/halcyon_settings:halcyon_settings_resources",
+      "//chrome/browser/resources/halcyon_tides:halcyon_tides_resources",
+      "//chrome/browser/resources/halcyon_cairn:halcyon_cairn_resources",
+      "//chrome/browser/resources/halcyon_cove:halcyon_cove_resources",
+      "//chrome/browser/resources/halcyon_lantern:halcyon_lantern_resources",
+      "//chrome/browser/resources/halcyon_lantern_report:halcyon_lantern_report_resources",
+      "//chrome/browser/resources/halcyon_about:halcyon_about_resources",
+      "//chrome/browser/resources/halcyon_quill:halcyon_quill_resources",
+      "//chrome/browser/resources/halcyon_margin_notes:halcyon_margin_notes_resources",
+      "//chrome/browser/resources/halcyon_shared:halcyon_shared_resources",
+    ]
+  }
+}
 }
